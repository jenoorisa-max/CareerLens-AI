# Copy this file to `.env` for local development (`.env` is git-ignored).
# On Vercel, set these in Project Settings > Environment Variables instead.

# GEMINI_API_KEY (required): Google Gemini API key, used only on the server
# (src/server/gemini.ts). It is never sent to the browser. Get one in Google
# AI Studio. The placeholder below is treated as "not configured".
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (optional): Gemini model to use. If unset, the app uses its
# default (gemini-3.1-flash-lite). Leave it unset unless you need to override it.
# GEMINI_MODEL="gemini-3.1-flash-lite"
